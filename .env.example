# Copia este fichero a .env SOLO en el VPS y ejecuta: chmod 600 .env
# En modo paper NO hace falta ningún .env.
#
# Clave de Kraken Futures. --check exige (GET /api/auth/v1/api-keys/v3/check):
#   permissions.general  = FULL_ACCESS  (lectura + trading)
#   permissions.transfer = NO_ACCESS    (sin retiros ni transferencias)
# Activa la restricción de IP a la del VPS (obligatoria si los permisos no se
# pudieran verificar).
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

# Alertas Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
